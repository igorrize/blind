{
  "name": "fixer",
  "kind": "worker",
  "input": {
    "type": "object",
    "required": [
      "findings"
    ],
    "properties": {
      "findings": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "changed"
    ],
    "properties": {
      "changed": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "rights": {
    "read": [
      "**"
    ],
    "write": [
      "crates/**"
    ],
    "written_as": "changed"
  }
}
