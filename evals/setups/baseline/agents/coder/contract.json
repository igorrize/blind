{
  "name": "coder",
  "kind": "worker",
  "input": {
    "type": "object",
    "required": ["steps", "files"],
    "properties": {
      "steps": { "type": "array", "maxItems": 15, "items": { "type": "string", "maxLength": 400 } },
      "files": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 200 } }
    }
  },
  "output": {
    "type": "object",
    "required": ["changed", "summary"],
    "properties": {
      "changed": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 200 } },
      "summary": { "type": "string", "maxLength": 3000 }
    }
  },
  "rights": {
    "read": ["**"],
    "write": ["crates/**", "README.md"]
  }
}
