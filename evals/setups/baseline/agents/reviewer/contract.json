{
  "name": "reviewer",
  "kind": "worker",
  "input": {
    "type": "object",
    "required": ["changed", "summary"],
    "properties": {
      "changed": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 200 } },
      "summary": { "type": "string", "maxLength": 3000 }
    }
  },
  "output": {
    "type": "object",
    "required": ["findings", "approved"],
    "properties": {
      "findings": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 400 } },
      "approved": { "type": "boolean" }
    }
  },
  "rights": {
    "read": ["**"],
    "read_from": "changed"
  }
}
