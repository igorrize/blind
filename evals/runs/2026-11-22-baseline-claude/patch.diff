--- /dev/null
+++ b/crates/blind/src/clipboard.rs
@@ -0,0 +1,108 @@
+use std::{
+    io::Write,
+    process::{ChildStdin, Command, Stdio},
+};
+
+use anyhow::{Context, ensure};
+
+const PROGRAM: &str = "pbcopy";
+
+type Sink = Box<dyn Fn(&str) -> anyhow::Result<()>>;
+
+pub struct Clipboard {
+    write: Sink,
+}
+
+impl Clipboard {
+    pub fn system() -> Self {
+        Self {
+            write: Box::new(|text: &str| piped(PROGRAM, text)),
+        }
+    }
+
+    pub fn copy(&self, text: &str) -> anyhow::Result<()> {
+        (self.write)(text)
+    }
+}
+
+fn piped(program: &str, text: &str) -> anyhow::Result<()> {
+    let mut child = Command::new(program)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .with_context(|| format!("{program} did not start"))?;
+    let fed = feed(child.stdin.take(), text);
+    let status = child
+        .wait()
+        .with_context(|| format!("{program} did not finish"))?;
+    fed?;
+    ensure!(status.success(), "{program} ended with {status}");
+    Ok(())
+}
+
+fn feed(input: Option<ChildStdin>, text: &str) -> anyhow::Result<()> {
+    let mut input = input.context("no input to write the text to")?;
+    input
+        .write_all(text.as_bytes())
+        .context("the text was not written")
+}
+
+#[cfg(test)]
+pub(crate) mod test_support {
+    use std::{cell::RefCell, rc::Rc};
+
+    use anyhow::anyhow;
+
+    use super::Clipboard;
+
+    pub type Copied = Rc<RefCell<Vec<String>>>;
+
+    pub fn recording() -> (Clipboard, Copied) {
+        let copied = Copied::default();
+        let kept = Rc::clone(&copied);
+        let write = move |text: &str| -> anyhow::Result<()> {
+            kept.borrow_mut().push(text.to_owned());
+            Ok(())
+        };
+        let clipboard = Clipboard {
+            write: Box::new(write),
+        };
+        (clipboard, copied)
+    }
+
+    pub fn broken() -> Clipboard {
+        Clipboard {
+            write: Box::new(refuse),
+        }
+    }
+
+    fn refuse(_text: &str) -> anyhow::Result<()> {
+        Err(anyhow!("no clipboard here"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MISSING_PROGRAM: &str = "blind-no-such-clipboard-program";
+
+    #[test]
+    fn text_is_fed_to_a_program_that_reads_it() {
+        assert!(piped("cat", "| a | b |\n|---|---|\n").is_ok());
+    }
+
+    #[test]
+    fn program_that_fails_is_an_error() {
+        assert!(piped("false", "text").is_err());
+    }
+
+    #[test]
+    fn missing_program_says_it_did_not_start() {
+        let error = piped(MISSING_PROGRAM, "text").expect_err("no such program");
+        let message = format!("{error:#}");
+        let expected = format!("{MISSING_PROGRAM} did not start");
+        assert!(message.contains(&expected), "{message}");
+    }
+}
